+// Placeholder ONNX Runtime custom op for a TensorRT plugin node (ONNX domain trt.plugins). It only makes ONNX Runtime
+// accept the node; the TensorRT EP hands the node to TensorRT's ONNX parser, which builds the plugin from TensorRT's
+// plugin registry (IPluginV3 plugins included, loaded through trt_extra_plugin_lib_paths). The kernel never runs.
+struct TrtPluginKernel {
+  TrtPluginKernel(const OrtApi&, const OrtKernelInfo*) {}
+  void Compute(OrtKernelContext*) {
+    throw Exception("TensorRT plugin node evaluated outside TensorRT");
+  }
+};
+
+struct TrtPluginOp : Ort::CustomOpBase<TrtPluginOp, TrtPluginKernel> {
+  explicit TrtPluginOp(std::string name) : name_(std::move(name)) {}
+  void* CreateKernel(const OrtApi& api, const OrtKernelInfo* info) const {
+    return new TrtPluginKernel(api, info);
+  }
+  const char* GetName() const { return name_.c_str(); }
+  const char* GetExecutionProviderType() const {
+    return "TensorrtExecutionProvider";
+  }
+  size_t GetInputTypeCount() const { return 1; }
+  ONNXTensorElementDataType GetInputType(size_t) const {
+    return ONNX_TENSOR_ELEMENT_DATA_TYPE_UNDEFINED;
+  }
+  OrtCustomOpInputOutputCharacteristic GetInputCharacteristic(size_t) const {
+    return OrtCustomOpInputOutputCharacteristic::INPUT_OUTPUT_VARIADIC;
+  }
+  size_t GetOutputTypeCount() const { return 1; }
+  ONNXTensorElementDataType GetOutputType(size_t) const {
+    return ONNX_TENSOR_ELEMENT_DATA_TYPE_UNDEFINED;
+  }
+  OrtCustomOpInputOutputCharacteristic GetOutputCharacteristic(size_t) const {
+    return OrtCustomOpInputOutputCharacteristic::INPUT_OUTPUT_VARIADIC;
+  }
+  bool GetVariadicInputHomogeneity() const { return false; }
+  bool GetVariadicOutputHomogeneity() const { return false; }
+
+ private:
+  std::string name_;
+};
+
 class OnnxNetwork;
 
