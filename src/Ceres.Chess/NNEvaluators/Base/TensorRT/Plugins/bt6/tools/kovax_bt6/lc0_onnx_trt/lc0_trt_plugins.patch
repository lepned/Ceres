+#ifdef USE_ONNX_CUDART
+void OnnxNetwork::CaptureGraph(GraphEntry* entry, int step,
+                               Ort::RunOptions& options,
+                               Ort::IoBinding& binding) {
+  // The caller has just done a normal Run with the same buffers and shapes, so TensorRT has no shape dependent
+  // work left; this second Run only records its kernel launches (nothing executes while the stream captures).
+  // A graph of this net (214 kernels) takes about 1.4 MB of host memory.
+  static constexpr size_t kMaxGraphs = 256;
+  if (graphs_captured_ >= kMaxGraphs) return;
+  if (cudaStreamBeginCapture(compute_stream_, cudaStreamCaptureModeThreadLocal) != cudaSuccess) {
+    cudaGetLastError();
+    cuda_graph_ = 0;
+    CERR << "CUDA graph: capture could not start, continuing without CUDA graphs.";
+    return;
+  }
+  std::string what;
+  try {
+    session_[step - 1].Run(options, binding);
+  } catch (const std::exception& e) {
+    what = e.what();
+    if (what.empty()) what = "Run failed";
+  }
+  cudaGraph_t graph = nullptr;
+  cudaError_t err = cudaStreamEndCapture(compute_stream_, &graph);
+  if (what.empty() && err == cudaSuccess && graph) {
+    err = cudaGraphInstantiate(&entry->exec, graph, 0);
+  }
+  if (graph) cudaGraphDestroy(graph);
+  if (!what.empty() || err != cudaSuccess || !entry->exec) {
+    cudaGetLastError();
+    entry->exec = nullptr;
+    cuda_graph_ = 0;
+    CERR << "CUDA graph: capture failed (" << (what.empty() ? cudaGetErrorString(err) : what)
+         << "), continuing without CUDA graphs.";
+    return;
+  }
+  graphs_captured_++;
+}
+#endif
